# Copy to .env and adjust. Never commit .env.

# Postgres (docker compose)
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint

# API (services/api). Outside Docker, point at localhost:
DATABASE_URL=postgresql+psycopg://waypoint:waypoint@localhost:5432/waypoint
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:3000
ENFORCE_CUTOFF=false
DEMO_SERVICE_DATE=2026-10-05

# Web (apps/web): the browser calls /api/*, Next forwards it to the API.
# Docker Compose sets this to http://api:8000. For `npm run dev` put your API address in apps/web/.env.local.
# API_INTERNAL_URL=http://localhost:8000

# Host ports (change if something else already uses them; container ports stay fixed)
# API_PORT=8000
# WEB_PORT=3000
# DB_PORT=5432
